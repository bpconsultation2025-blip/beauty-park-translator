# ============================================================
# 뷰티파크 번역 시스템 환경변수 설정
# ============================================================
# Vercel 배포 시: 대시보드 → Settings → Environment Variables 에 아래 값을 입력하세요.
# 로컬 개발 시: 이 파일을 '.env.local' 로 복사한 뒤 값을 채워주세요.

# ---- Gemini API (필수) ----
# Google AI Studio에서 무료로 발급받으세요: https://aistudio.google.com/apikey
# "Create API key" 클릭 → 생성된 키(AIza... 로 시작)를 복사해서 붙여넣기
GEMINI_API_KEY=여기에_붙여넣기

# ---- Gemini 모델 (선택) ----
# 비워두면 기본값 gemini-2.5-flash 사용. 바꾸고 싶을 때만 설정하세요.
# GEMINI_MODEL=gemini-2.5-flash
